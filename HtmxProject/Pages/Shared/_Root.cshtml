@using Htmx.TagHelpers
@inject HtmxProject.Infrastructure.StaticContent.HtmlContentManager JavaScriptBundler

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - HtmxProject</title>
	@* TODO: Improve font loading *@
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
	<meta name="htmx-config"
		  historyCacheSize="20"
		  indicatorClass="htmx-indicator"
		  includeAspNetAntiforgeryToken="true" />
	<link rel="stylesheet" href="~/bundles/css/tailwind.css" asp-append-version="true" />
	@* <link rel="stylesheet" href="~/bundles/css/accordion.css" asp-append-version="true" /> *@
	@await RenderSectionAsync("Styles", required: false)
	<script src="@HtmxAntiforgeryScriptEndpoints.Path" defer></script>
</head>
<body class="scrollbar-thin scrollbar-thumb-sky-700 scrollbar-track-sky-300 dark:bg-[#161c23]" hx-ext="loading-states">
	<nav id="header" class="fixed top-0 z-10 w-full bg-blue-500 dark:bg-black-600">
		<div class="mx-auto mt-0 flex w-full flex-wrap items-center justify-between py-3 md:max-w-4xl">
			<div class="pl-4">
				<a class="text-xl font-extrabold text-gray-900 no-underline hover:no-underline" href="#">
					Minimal Blog
				</a>
			</div>
			<div class="block pr-4 lg:hidden">
				<button id="nav-toggle"
						class="flex appearance-none items-center rounded border border-gray-600 px-3 py-2 text-gray-500 hover:border-green-500 hover:text-gray-900 focus:outline-none">
					<svg class="h-3 w-3 text-gray-500" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
						<title>Menu</title>
						<path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z" />
					</svg>
				</button>
			</div>
			<div class="z-20 mt-2 hidden w-full flex-grow bg-gray-100 md:bg-transparent lg:mt-0 lg:block lg:flex lg:w-auto lg:items-center"
				 id="nav-content">
				<ul class="list-reset flex-1 items-center justify-end lg:flex">
					<li class="mr-3">
						<a class="inline-block px-4 py-2 font-bold text-gray-900 no-underline" href="#">Active</a>
					</li>
					<li class="mr-3">
						<a class="inline-block px-4 py-2 text-gray-600 no-underline hover:text-underline hover:text-gray-900"
						   href="#">link</a>
					</li>
					<li class="mr-3">
						<a class="inline-block px-4 py-2 text-gray-600 no-underline hover:text-underline hover:text-gray-900" onclick="LayoutUtils.toggleMode();"
						   href="#">link</a>
					</li>
					<li class="mr-3">
						<island url="/account?handler=userinfo" event="Load" trigger="profile-update from:body" class="inline-block"> 
						</island>						
					</li>
				</ul>
			</div>
		</div>
	</nav>
	@RenderBody()
	<footer class="border-t border-gray-400 bg-white shadow">
		<div class="container mx-auto flex max-w-4xl py-8">
			<div class="mx-auto flex w-full flex-wrap">
				<div class="flex w-full md:w-1/2">
					<div class="px-8">
						<h3 class="font-bold text-gray-900">About</h3>
						<p class="py-4 text-sm text-gray-600">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas vel mi ut felis tempus
							commodo nec id erat. Suspendisse consectetur dapibus velit ut lacinia.
						</p>
					</div>
				</div>
				<div class="flex w-full md:w-1/2">
					<div class="px-8">
						<h3 class="font-bold text-gray-900">Social</h3>
						<ul class="list-reset items-center pt-3 text-sm">
							<li>
								<a class="inline-block py-1 text-gray-600 no-underline hover:text-underline hover:text-gray-900"
								   href="#">Add social link</a>
							</li>
							<li>
								<a class="inline-block py-1 text-gray-600 no-underline hover:text-underline hover:text-gray-900"
								   href="#">Add social link</a>
							</li>
							<li>
								<a class="inline-block py-1 text-gray-600 no-underline hover:text-underline hover:text-gray-900"
								   href="#">Add social link</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</footer>
	@* Copy js to bundle directory *@
	<script src="~/bundles/js/htmx.js"></script>
	<script src="~/bundles/js/loading-states.js"></script>
	<script src="~/bundles/js/accordion.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@JavaScriptBundler.GenerateScriptParts(Infrastructure.StaticContent.ResourceLocation.Footer)
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
