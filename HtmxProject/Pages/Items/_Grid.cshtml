@model HtmxProject.Pages.Items.IndexModel
@{
	var pager = new HtmxProject.Models.Base.PageModel(Model.PagedResult.TotalCount, 0, Model.PageIndex, Model.PageSize, "/items");
}
@if (Model.PagedResult.Items.Count > 0)
{
	<div class="grid grid-cols-4 gap-4">
		@foreach (var item in Model.PagedResult.Items)
		{
			<div class="w-full max-w-sm bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
				<a href="#">
					<img class="p-8 rounded-t-lg" src="~/img/default-product-image.png" alt="product image" />
				</a>
				<div class="px-5 pb-5">
					<a href="#">
						<h5 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white">
							@item.Name
						</h5>
					</a>
					<div class="flex items-center justify-between">
						<span class="text-3xl font-bold text-gray-900 dark:text-white">$599</span>
						<button type="submit"
							hx-post="/items?handler=addToCart"
							hx-disabled-elt="[type='submit']"
							style="@Style.Info">
							Add to cart
						</button>						
					</div>
				</div>
			</div>
		}
	</div>
	@Html.DisplayFor(m => pager)
}
else
{
	<p>No more data</p>
}
